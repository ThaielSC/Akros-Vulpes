---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
}

const { title = "Akros Vulpes | Formula SAE UANDES" } = Astro.props;

// Determine the current path for active nav highlighting
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- SEO Meta Tags -->
		<meta name="description" content="Sitio web oficial de Akros Vulpes, equipo de Formula SAE de la Universidad de los Andes, Chile. Diseñando y manufacturando el futuro del automovilismo de competición." />
		<meta name="keywords" content="Akros Vulpes, Formula SAE, UANDES, Universidad de los Andes, Motorsport Chile, Formula Student, FSAE" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Equipo de Formula Student de la Universidad de los Andes, Chile. Pasión, ingeniería y velocidad en la cordillera." />
		<meta property="og:type" content="website" />
		
		<!-- Preconnect to Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

		<!-- View Transitions -->
		<ClientRouter />
	</head>
	<body>
		<!-- Header / Navigation -->
		<header class="main-header">
			<div class="nav-container">
				<a href="/" class="logo-area" transition:name="logo">
					<span class="logo-prefix">AKROS</span>
					<span class="logo-suffix">VULPES</span>
					<span class="logo-sub font-tech">FSAE UANDES</span>
				</a>
				
				<nav class="nav-links">
					<a href="/" class={`nav-link ${currentPath === '/' ? 'nav-active' : ''}`}>Inicio</a>
					<a href="/desarrollo" class={`nav-link ${currentPath === '/desarrollo/' || currentPath === '/desarrollo' ? 'nav-active' : ''}`}>Desarrollo</a>
					<a href="/auto" class={`nav-link ${currentPath === '/auto/' || currentPath === '/auto' ? 'nav-active' : ''}`}>El Auto</a>
					<a href="/equipo" class={`nav-link ${currentPath === '/equipo/' || currentPath === '/equipo' ? 'nav-active' : ''}`}>El Equipo</a>
					<a href="/sponsors" class={`nav-link ${currentPath === '/sponsors/' || currentPath === '/sponsors' ? 'nav-active' : ''}`}>Sponsors</a>
				</nav>

				<div class="nav-actions">
					<a href="/sponsors#contacto" class="btn-racing"><span>Únete</span></a>
				</div>
			</div>
		</header>

		<!-- Page Content -->
		<main transition:animate="fade">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="main-footer">
			<div class="footer-grid">
				<div class="footer-brand">
					<h3 class="text-gradient-red">AKROS VULPES</h3>
					<p class="brand-desc">
						Escudería de Formula Student (SAE) de la Universidad de los Andes. Desafiando los límites de la ingeniería andina en cada curva.
					</p>
					<div class="uni-tag">
						<span class="bullet"></span> Universidad de los Andes, Chile.
					</div>
				</div>
				
				<div class="footer-links-group">
					<h4>Navegación</h4>
					<ul>
						<li><a href="/">Inicio</a></li>
						<li><a href="/desarrollo">Fases de Desarrollo</a></li>
						<li><a href="/auto">El Monoplaza</a></li>
						<li><a href="/equipo">El Equipo</a></li>
						<li><a href="/sponsors">Sponsors & Contacto</a></li>
					</ul>
				</div>
				
				<div class="footer-links-group">
					<h4>Contacto</h4>
					<ul>
						<li><span class="font-tech text-small">Email:</span> formula.sae@miuandes.cl</li>
						<li><span class="font-tech text-small">Sede:</span> San Carlos de Apoquindo 2200</li>
						<li><span class="font-tech text-small">Ciudad:</span> Las Condes, Santiago, Chile</li>
					</ul>
				</div>

				<div class="footer-meta font-tech">
					<div class="tech-spec-row">
						<span>VEHICLE CLASS:</span>
						<span class="highlight-val">COMBUSTION (CV)</span>
					</div>
					<div class="tech-spec-row">
						<span>TEAM MASCOT:</span>
						<span class="highlight-val">LYCALOPEX CULPAEUS</span>
					</div>
					<div class="tech-spec-row">
						<span>BUILD:</span>
						<span class="highlight-val">v1.0.0-ASTRO</span>
					</div>
				</div>
			</div>
			
			<div class="footer-bottom">
				<p>&copy; {new Date().getFullYear()} Akros Vulpes Formula SAE. Todos los derechos reservados.</p>
				<p class="font-tech text-muted">DESIGNED FOR SPEED // BUILT FOR GLORY</p>
			</div>
		</footer>
	</body>
</html>

<style>
	/* Header styles */
	.main-header {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 100;
		background: rgba(10, 10, 10, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(138, 138, 130, 0.15);
	}

	.nav-container {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 2rem;
	}

	.logo-area {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		line-height: 1;
	}

	.logo-prefix {
		font-family: var(--font-headings);
		font-size: 1.5rem;
		font-weight: 900;
		font-style: italic;
		color: var(--color-blanco-hueso);
		letter-spacing: -0.03em;
	}

	.logo-suffix {
		font-family: var(--font-headings);
		font-size: 1.5rem;
		font-weight: 900;
		font-style: italic;
		color: var(--color-rojo-culpeo);
		letter-spacing: -0.03em;
		margin-top: -2px;
	}

	.logo-sub {
		font-size: 0.65rem;
		color: var(--color-gris-andino);
		letter-spacing: 0.1em;
		margin-top: 4px;
	}

	.nav-links {
		display: flex;
		gap: 2.5rem;
	}

	.nav-link {
		font-family: var(--font-headings);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 0.85rem;
		color: var(--color-gris-andino);
		text-decoration: none;
		letter-spacing: 0.05em;
		position: relative;
		padding: 0.25rem 0;
		transition: color 0.3s ease;
	}

	.nav-link::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--color-rojo-culpeo);
		transition: width 0.3s ease;
	}

	.nav-link:hover,
	.nav-link.nav-active {
		color: var(--color-blanco-hueso);
	}

	.nav-link:hover::after,
	.nav-link.nav-active::after {
		width: 100%;
	}

	.nav-active::after {
		background: var(--color-oro-andino) !important;
	}

	.btn-small {
		padding: 0.5rem 1.25rem;
		font-size: 0.8rem;
	}

	/* Footer Styles */
	.main-footer {
		background: var(--color-carbon);
		border-top: 2px solid var(--color-rojo-culpeo);
		padding: 5rem 2rem 2rem 2rem;
		position: relative;
		z-index: 10;
		margin-top: 8rem;
	}

	.footer-grid {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1.5fr;
		gap: 3rem;
		padding-bottom: 4rem;
		border-bottom: 1px solid rgba(138, 138, 130, 0.1);
	}

	.footer-brand h3 {
		font-size: 1.75rem;
		margin-bottom: 1.5rem;
		font-style: italic;
		letter-spacing: -0.02em;
	}

	.brand-desc {
		color: var(--color-gris-andino);
		font-size: 0.95rem;
		margin-bottom: 1.5rem;
		max-width: 320px;
	}

	.uni-tag {
		display: inline-flex;
		align-items: center;
		background: rgba(184, 150, 106, 0.1);
		border: 1px solid var(--color-oro-andino);
		color: var(--color-oro-andino);
		font-size: 0.8rem;
		padding: 0.35rem 0.75rem;
		font-weight: 600;
	}

	.bullet {
		width: 6px;
		height: 6px;
		background: var(--color-oro-andino);
		border-radius: 50%;
		margin-right: 8px;
		display: inline-block;
	}

	.footer-links-group h4 {
		font-size: 1rem;
		margin-bottom: 1.5rem;
		color: var(--color-blanco-hueso);
		position: relative;
		padding-bottom: 0.5rem;
	}

	.footer-links-group h4::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 30px;
		height: 2px;
		background: var(--color-terracota);
	}

	.footer-links-group ul {
		list-style: none;
	}

	.footer-links-group li {
		margin-bottom: 0.75rem;
		color: var(--color-gris-andino);
		font-size: 0.9rem;
	}

	.footer-links-group a {
		color: var(--color-gris-andino);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.3s ease, padding-left 0.3s ease;
	}

	.footer-links-group a:hover {
		color: var(--color-rojo-culpeo);
		padding-left: 4px;
	}

	.text-small {
		font-size: 0.75rem;
		color: var(--color-oro-andino);
		display: block;
		margin-bottom: 0.15rem;
	}

	.footer-meta {
		background: rgba(10, 10, 10, 0.5);
		padding: 1.5rem;
		border: 1px dashed rgba(138, 138, 130, 0.2);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.tech-spec-row {
		display: flex;
		justify-content: space-between;
		font-size: 0.75rem;
		color: var(--color-gris-andino);
	}

	.highlight-val {
		color: var(--color-blanco-hueso);
		font-weight: bold;
	}

	.footer-bottom {
		max-width: var(--max-width);
		margin: 0 auto;
		padding-top: 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.8rem;
		color: var(--color-gris-andino);
	}

	.text-muted {
		letter-spacing: 0.15em;
		color: rgba(138, 138, 130, 0.4);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.nav-links {
			display: none;
		}
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
	}

	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
	}
</style>
