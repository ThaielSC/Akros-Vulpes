---
const specs = [
  {
    category: "CHASIS & SEGURIDAD",
    items: [
      { name: "Estructura", val: "Tubular de acero aleado SAE 4130" },
      { name: "Célula de Impacto", val: "Atenuador de impacto de aluminio tipo panal de abeja" },
      { name: "Rigidez Torsional", val: "1850 Nm/grado" },
      { name: "Peso del Chasis", val: "28 kg" }
    ]
  },
  {
    category: "TREN MOTRIZ (POWERTRAIN)",
    items: [
      { name: "Motor", val: "Combustión Interna - Monocilíndrico 450cc" },
      { name: "Admisión", val: "Impresa en 3D con restrictores obligatorios FSAE" },
      { name: "Escape", val: "Escape de alto rendimiento optimizado por CFD" },
      { name: "Combustible", val: "Gasolina de 98 octanos / Mapa personalizado" }
    ]
  },
  {
    category: "SUSPENSIÓN & DIRECCIÓN",
    items: [
      { name: "Configuración", val: "Doble horquilla (Double Wishbone) pushrod" },
      { name: "Amortiguadores", val: "Öhlins TTX25 de 2 vías ajustables" },
      { name: "Manguetas", val: "Aluminio 7075-T6 mecanizado por CNC" },
      { name: "Neumáticos", val: "Hoosier R25B de 10 pulgadas de competición" }
    ]
  },
  {
    category: "AERODINÁMICA & TELEMETRÍA",
    items: [
      { name: "Paquete Aero", val: "Alerón delantero, difusor y alerón trasero con DRS" },
      { name: "ECU / Adquisición", val: "MoTeC M130 con telemetría inalámbrica" },
      { name: "Sensores", val: "Sensores de recorrido de suspensión, presión de frenos e IMU" },
      { name: "Panel de Piloto", val: "Tablero LCD MoTeC C125 montado en el volante" }
    ]
  }
];
---

<section id="auto" class="specs-section">
  <div class="section-header">
    <div class="tech-tag font-tech">TECHNICAL DATA // VEHICLE CV-01</div>
    <h2 class="section-title">Especificaciones <span class="text-gradient-red">Técnicas</span></h2>
    <p class="section-subtitle">
      El diseño de ingeniería detrás de nuestro monoplaza de combustión, optimizado para máxima agilidad y velocidad en pista.
    </p>
  </div>

  <div class="specs-grid">
    <!-- Blueprint / Vector Visual (F1 style skeleton) -->
    <div class="blueprint-card bevel-card blueprint-grid">
      <div class="blueprint-header">
        <span class="font-tech text-small">VULPES CV-01 // WIREFRAME SKELETON</span>
        <span class="blueprint-scale font-tech">ESCALA 1:15</span>
      </div>
      
      <div class="blueprint-vector-container">
        <!-- SVG vector showing a formula car outline -->
        <svg viewBox="0 0 500 250" class="blueprint-svg">
          <!-- Reference grid lines in SVG -->
          <line x1="0" y1="125" x2="500" y2="125" stroke="rgba(138, 138, 130, 0.2)" stroke-dasharray="4,4" />
          <line x1="100" y1="0" x2="100" y2="250" stroke="rgba(138, 138, 130, 0.15)" stroke-dasharray="4,4" />
          <line x1="250" y1="0" x2="250" y2="250" stroke="rgba(138, 138, 130, 0.15)" stroke-dasharray="4,4" />
          <line x1="400" y1="0" x2="400" y2="250" stroke="rgba(138, 138, 130, 0.15)" stroke-dasharray="4,4" />
          
          <!-- Car Silhouette (side profile representation) -->
          <!-- Rear wing -->
          <path d="M 40,80 L 70,80 L 70,120 L 40,120 Z" fill="none" stroke="var(--color-oro-andino)" stroke-width="2" />
          <path d="M 50,70 L 80,75 L 80,95 L 50,90 Z" fill="none" stroke="var(--color-rojo-culpeo)" stroke-width="1.5" />
          <line x1="70" y1="100" x2="120" y2="150" stroke="var(--color-gris-andino)" stroke-width="2" />
          
          <!-- Body chassis main line -->
          <path d="M 80,135 L 120,130 L 170,110 L 250,110 L 320,135 L 390,140 L 440,145 L 460,150 L 440,155 L 350,155 L 290,165 L 150,165 L 100,155 L 80,135" fill="none" stroke="var(--color-blanco-hueso)" stroke-width="2" stroke-linejoin="round" />
          
          <!-- Cockpit / Driver halo / Roll hoop -->
          <path d="M 210,110 Q 230,60 250,110" fill="none" stroke="var(--color-blanco-hueso)" stroke-width="2" />
          <path d="M 240,90 L 285,135" fill="none" stroke="var(--color-gris-andino)" stroke-width="1.5" />
          
          <!-- Engine Compartment -->
          <rect x="130" y="125" width="60" height="35" rx="3" fill="none" stroke="var(--color-terracota)" stroke-width="1.5" stroke-dasharray="2,2" />
          <circle cx="160" cy="142" r="10" fill="none" stroke="var(--color-terracota)" stroke-width="1.5" />
          
          <!-- Front wing -->
          <path d="M 440,145 L 470,145 L 485,150 L 450,155 Z" fill="none" stroke="var(--color-rojo-culpeo)" stroke-width="2" />
          <path d="M 460,138 L 480,138 L 480,148 L 460,148 Z" fill="none" stroke="var(--color-oro-andino)" stroke-width="1" />

          <!-- Rear Wheel -->
          <circle cx="120" cy="170" r="42" fill="none" stroke="var(--color-gris-andino)" stroke-width="3" />
          <circle cx="120" cy="170" r="22" fill="none" stroke="var(--color-oro-andino)" stroke-width="1.5" />
          <!-- Wheel spokes -->
          <line x1="120" y1="148" x2="120" y2="192" stroke="var(--color-gris-andino)" stroke-width="1" />
          <line x1="98" y1="170" x2="142" y2="170" stroke="var(--color-gris-andino)" stroke-width="1" />
          
          <!-- Front Wheel -->
          <circle cx="360" cy="170" r="42" fill="none" stroke="var(--color-gris-andino)" stroke-width="3" />
          <circle cx="360" cy="170" r="22" fill="none" stroke="var(--color-oro-andino)" stroke-width="1.5" />
          <!-- Wheel spokes -->
          <line x1="360" y1="148" x2="360" y2="192" stroke="var(--color-gris-andino)" stroke-width="1" />
          <line x1="338" y1="170" x2="382" y2="170" stroke="var(--color-gris-andino)" stroke-width="1" />

          <!-- Suspension rods (wishbones) -->
          <!-- Rear Suspension -->
          <line x1="120" y1="170" x2="170" y2="135" stroke="var(--color-rojo-culpeo)" stroke-width="1.5" />
          <line x1="120" y1="170" x2="170" y2="160" stroke="var(--color-rojo-culpeo)" stroke-width="1.5" />
          
          <!-- Front Suspension -->
          <line x1="360" y1="170" x2="300" y2="135" stroke="var(--color-rojo-culpeo)" stroke-width="1.5" />
          <line x1="360" y1="170" x2="300" y2="160" stroke="var(--color-rojo-culpeo)" stroke-width="1.5" />
          
          <!-- Technical Callouts -->
          <text x="360" y="235" class="svg-tech-text" fill="var(--color-oro-andino)">WHEELBASE: 1530mm</text>
          <text x="70" y="25" class="svg-tech-text" fill="var(--color-oro-andino)">DRS ACTIVE WING</text>
          <path d="M 65,30 L 65,65" fill="none" stroke="var(--color-oro-andino)" stroke-width="1" marker-end="url(#arrow)" />
        </svg>
      </div>

      <div class="blueprint-footer">
        <div class="telemetry-bar">
          <span class="telemetry-item"><span class="label">TEMP:</span> 94°C</span>
          <span class="telemetry-item"><span class="label">RPM:</span> 11,200</span>
          <span class="telemetry-item"><span class="label">GEAR:</span> N</span>
          <span class="telemetry-item"><span class="label">PRESSURE:</span> 1.2 BAR</span>
        </div>
      </div>
    </div>

    <!-- Specs List / Accordion -->
    <div class="specs-list">
      {specs.map((spec) => (
        <div class="spec-cat-card">
          <div class="spec-cat-title">
            <span class="cat-indicator"></span>
            <h3>{spec.category}</h3>
          </div>
          
          <div class="spec-items-container">
            {spec.items.map((item) => (
              <div class="spec-row">
                <span class="spec-name font-tech">{item.name}</span>
                <span class="spec-line-dots"></span>
                <span class="spec-val">{item.val}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .specs-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 2rem;
    position: relative;
  }

  .section-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .tech-tag {
    font-size: 0.8rem;
    color: var(--color-oro-andino);
    letter-spacing: 0.2em;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: 3rem;
    font-style: italic;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .section-subtitle {
    color: var(--color-gris-andino);
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  /* Grid Layout */
  .specs-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  /* Blueprint Card Styles */
  .blueprint-card {
    background: var(--color-carbon);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem;
    border: 1px solid rgba(184, 150, 106, 0.2);
  }

  .blueprint-header {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgba(138, 138, 130, 0.2);
    padding-bottom: 0.75rem;
  }

  .blueprint-scale {
    font-size: 0.75rem;
    color: var(--color-oro-andino);
  }

  .blueprint-vector-container {
    padding: 2rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 250px;
  }

  .blueprint-svg {
    width: 100%;
    height: auto;
    max-height: 280px;
  }

  .svg-tech-text {
    font-family: var(--font-technical);
    font-size: 10px;
    font-weight: bold;
  }

  .blueprint-footer {
    border-top: 1px solid rgba(138, 138, 130, 0.2);
    padding-top: 0.75rem;
  }

  .telemetry-bar {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-technical);
    font-size: 0.8rem;
    color: var(--color-blanco-hueso);
  }

  .telemetry-item .label {
    color: var(--color-rojo-culpeo);
    font-weight: bold;
  }

  /* Specs List Accordion */
  .specs-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .spec-cat-card {
    background: rgba(30, 30, 26, 0.4);
    border-left: 3px solid var(--color-oro-andino);
    padding: 1rem 1.5rem 1.5rem 1.5rem;
    border-radius: 0 4px 4px 0;
  }

  .spec-cat-card:nth-child(even) {
    border-left-color: var(--color-rojo-culpeo);
  }

  .spec-cat-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(138, 138, 130, 0.1);
    padding-bottom: 0.5rem;
  }

  .cat-indicator {
    width: 8px;
    height: 8px;
    background: var(--color-oro-andino);
    transform: rotate(45deg);
  }

  .spec-cat-card:nth-child(even) .cat-indicator {
    background: var(--color-rojo-culpeo);
  }

  .spec-cat-title h3 {
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: var(--color-blanco-hueso);
  }

  .spec-items-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
  }

  .spec-name {
    color: var(--color-gris-andino);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .spec-line-dots {
    flex-grow: 1;
    border-bottom: 1px dashed rgba(138, 138, 130, 0.2);
    margin: 0 1rem;
  }

  .spec-val {
    color: var(--color-blanco-hueso);
    font-weight: 500;
    text-align: right;
  }

  @media (max-width: 900px) {
    .specs-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
